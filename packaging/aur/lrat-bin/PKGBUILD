# Maintainer: Carlos García <31284110+cxrlos at users dot noreply dot github dot com>

pkgname=lrat-bin
pkgver=0.2.0
pkgrel=1
pkgdesc='A fast, keyboard-first terminal client for Linear (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/cxrlos/linear-rat'
license=('MIT OR Apache-2.0')
depends=('gcc-libs' 'glibc')
provides=('lrat')
conflicts=('lrat')
# The release binary carries no debug info to split out.
options=('!debug')
# dist names its archives without the version, so each source gets one here
# to keep makepkg's source cache from mixing up releases.
source_x86_64=("lrat-$pkgver-x86_64.tar.xz::$url/releases/download/v$pkgver/linear-rat-x86_64-unknown-linux-gnu.tar.xz")
source_aarch64=("lrat-$pkgver-aarch64.tar.xz::$url/releases/download/v$pkgver/linear-rat-aarch64-unknown-linux-gnu.tar.xz")
sha256sums_x86_64=('cbf2f5b34f4544b9a46748e090d343095494b59a775bb74f6e233fb6d690c772')
sha256sums_aarch64=('c22d0433a287af527625e7fcffaad09dd50fe6237c9a8591c6f4101be0a70b07')

package() {
  cd "linear-rat-$CARCH-unknown-linux-gnu"
  install -Dm755 lrat -t "$pkgdir/usr/bin/"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
  install -Dm644 completions/lrat.bash "$pkgdir/usr/share/bash-completion/completions/lrat"
  install -Dm644 completions/_lrat -t "$pkgdir/usr/share/zsh/site-functions/"
  install -Dm644 completions/lrat.fish -t "$pkgdir/usr/share/fish/vendor_completions.d/"
  install -Dm644 man/*.1 -t "$pkgdir/usr/share/man/man1/"
}
